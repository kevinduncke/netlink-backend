generator client {
  provider = "prisma-client"
  output   = "../src/config/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())

  // Profile Section
  name          String?
  username      String?   @unique
  bio           String?
  url           String?
  avatarUrl     String?

  // Relations 
  posts         Post[]
  likes         Like[]
  comments      Comment[]
  followers     Follow[]  @relation("followers")
  following     Follow[]  @relation("following")
  messages      Message[] @relation("userMessages")
  chats         Chat[]    @relation("userChats")
  chatHides     ChatHidden[] @relation("userChatHides")
  notifications Notification[]
  visiblePosts  Post[]    @relation("SpecificVisibility")
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
  SPECIFIC
}

model Post {
  id              String           @id @default(uuid())
  content         String
  location        String?
  visibility      PostVisibility   @default(PUBLIC)
  specificTo      User[]           @relation("SpecificVisibility")
  hideLikes       Boolean          @default(false)
  disableComments Boolean          @default(false)  
  imageUrl        String?
  createdAt       DateTime         @default(now())

  author          User             @relation(fields: [authorId], references: [id])
  authorId        String

  likes           Like[]
  comments        Comment[]

  isShared        Boolean          @default(false)
  sharedFromId    String?
  sharedFrom      Post?            @relation("SharedPost", fields: [sharedFromId], references: [id])
  sharedPosts     Post[]           @relation("SharedPost")
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  userId    String

  post      Post     @relation(fields: [postId], references: [id])
  postId    String

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  author    User     @relation(fields: [authorId], references: [id])
  authorId  String

  post      Post     @relation(fields: [postId], references: [id])
  postId    String
}

model Follow {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  follower      User      @relation("followers", fields: [followerId], references: [id])
  followerId    String

  following     User      @relation("following", fields: [followingId], references: [id])
  followingId   String
}

model Chat {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  users         User[]    @relation("userChats")
  messages      Message[]
  hiddenBy      ChatHidden[] @relation("chatHidden")
}

model ChatHidden {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  chat          Chat      @relation("chatHidden", fields: [chatId], references: [id], onDelete: Cascade)
  chatId        String

  user          User      @relation("userChatHides", fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  @@unique([chatId, userId])
}

model Message {
  id            String    @id @default(uuid())
  content       String
  createdAt     DateTime  @default(now())

  chat          Chat      @relation(fields: [chatId], references: [id])
  chatId        String

  sender        User      @relation("userMessages", fields: [senderId], references: [id])
  senderId      String
}

model Notification {
  id            String    @id @default(uuid())
  type          String
  message       String
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id])
  userId        String
}