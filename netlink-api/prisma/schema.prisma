generator client {
  provider = "prisma-client"
  output   = "../src/config/generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                  @id @default(cuid())
  email               String                  @unique
  password            String
  createdAt           DateTime                @default(now())

  // Profile Section
  name                String?
  username            String?                 @unique
  bio                 String?
  url                 String?
  avatarUrl           String?
  privacyMode         Boolean                 @default(false)

  // Relations 
  posts               Post[]
  likes               Like[]
  comments            Comment[]
  shares              Share[]
  mentions            Mention[]
  followers           Follow[]                @relation("followers")
  following           Follow[]                @relation("following")
  messages            Message[]               @relation("userMessages")
  chatParticipants    ChatParticipant[]
  chatHides           ChatHidden[]            @relation("userChatHides")
  notifications       Notification[]
  sentNotifications   Notification[]          @relation("NotificationFromUser")
  sentMentions        Mention[]               @relation("MentionFromUser")
  
  visiblePosts        Post[]                  @relation("SpecificVisibility")

  favorites           Favorite[]              @relation("UserFavorites")
  favoredBy           Favorite[]              @relation("UserFavoredBy")  
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS
  ONLY_ME
  SPECIFIC
}

enum NotificationTypes {
  FOLLOW
  LIKE
  COMMENT
  REPOST
  MENTION
  MESSAGE
}

model Post {
  id              String           @id @default(uuid())
  content         String
  location        String?
  visibility      PostVisibility   @default(PUBLIC)
  hideLikes       Boolean          @default(false)
  disableComments Boolean          @default(false)  
  imageUrl        String?
  createdAt       DateTime         @default(now())

  // Relations
  author          User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  specificTo      User[]           @relation("SpecificVisibility")
  likes           Like[]
  comments        Comment[]
  shares          Share[]
  mentions        Mention[]
  notifications    Notification[]
}

model Like {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String

  notifications Notification[]

  @@unique([userId, postId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  
  notifications Notification[]
}

model Share {
  id              String          @id @default(uuid())
  userId          String
  postId          String
  createdAt       DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  post            Post            @relation(fields: [postId], references: [id], onDelete: Cascade)

  notifications   Notification[]
  mentions        Mention[]

  @@unique([userId, postId])
}

model Follow {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  follower      User      @relation("followers", fields: [followerId], references: [id], onDelete: Cascade)
  followerId    String

  following     User      @relation("following", fields: [followingId], references: [id], onDelete: Cascade)
  followingId   String

  notifications Notification[]
}

model Favorite {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())

  // THE USER WHO FAVORITES SOMEONE
  user          User     @relation("UserFavorites", fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  favorite      User     @relation("UserFavoredBy", fields: [favoriteId], references: [id], onDelete: Cascade)
  favoriteId    String  
}

model Chat {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())

  participants    ChatParticipant[]
  messages        Message[]
  notifications   Notification[]
  hiddenBy        ChatHidden[] @relation("chatHidden")
}

model ChatParticipant {
  id            String    @id @default(uuid())
  chatId        String
  userId        String

  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId]) // prev dup
}

model ChatHidden {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  chat          Chat      @relation("chatHidden", fields: [chatId], references: [id], onDelete: Cascade)
  chatId        String

  user          User      @relation("userChatHides", fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  @@unique([chatId, userId])
}

model Message {
  id            String    @id @default(uuid())
  content       String
  createdAt     DateTime  @default(now())
  sent          Boolean   @default(false)
  received      Boolean   @default(false)
  read          Boolean   @default(false)

  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId        String

  sender        User      @relation("userMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderId      String

  notifications   Notification[]
}

model Notification {
  id            String               @id @default(uuid())
  type          NotificationTypes    
  content       String?
  read          Boolean              @default(false)
  createdAt     DateTime             @default(now())

  // DEST
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // SOURCE
  fromUserId    String?
  fromUser      User?     @relation("NotificationFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  // OPT DEPENDING ON TYPE
  postId        String?
  post          Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)

  chatId        String?
  chat          Chat?     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  
  commentId     String?
  comment       Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  likeId        String?
  like          Like?     @relation(fields: [likeId], references: [id], onDelete: Cascade)

  shareId       String?
  share         Share?    @relation(fields: [shareId], references: [id], onDelete: Cascade)

  followId      String?
  follow        Follow?   @relation(fields: [followId], references: [id], onDelete: Cascade)

  messageId     String?
  message       Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Mention {
  id            String    @id @default(uuid())
  createdAt     DateTime  @default(now())

  fromUserId    String?
  fromUser      User?     @relation("MentionFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)

  post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId        String

  share         Share?    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  shareId       String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String

  @@unique([postId, userId])
}